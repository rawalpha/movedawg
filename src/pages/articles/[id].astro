---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { id: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();
---

<BaseLayout title={article.data.title} description={article.data.summary} ogImage={article.data.coverImage}>
  <main class="mx-auto max-w-2xl px-4 pb-24 pt-16 sm:px-6 lg:px-8">
    <a href="/" class="text-xs text-neutral-500 hover:text-neutral-300">← На главную</a>

    {article.data.tags.length > 0 && (
      <div class="mt-6 flex gap-1.5">
        {article.data.tags.map((tag) => (
          <span class="rounded-full border border-neutral-800 px-2 py-0.5 text-[11px] uppercase tracking-wide text-neutral-500">{tag}</span>
        ))}
      </div>
    )}

    <h1 class="mt-3 text-3xl font-medium leading-tight text-neutral-50">{article.data.title}</h1>
    <p class="mt-3 text-sm text-neutral-400">{article.data.summary}</p>

    {article.data.coverImage && (
      <img src={article.data.coverImage} alt={article.data.title} class="mt-8 w-full rounded-2xl border border-neutral-800" />
    )}

    <div class="prose prose-invert prose-sm mt-8 max-w-none prose-headings:font-medium prose-headings:text-neutral-100 prose-p:text-neutral-400 prose-a:text-accent">
      <Content />
    </div>
  </main>
</BaseLayout>
