---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const countries = await getCollection('countries');
  const cities = await getCollection('cities');
  return countries.map((country) => ({
    params: { id: country.slug },
    props: { country, cities: cities.filter((c) => c.data.country === country.slug) },
  }));
}

const { country, cities } = Astro.props;
const { Content } = await country.render();
---

<BaseLayout title={country.data.title} description={country.data.description}>
  <main class="mx-auto max-w-4xl px-4 pb-24 pt-16 sm:px-6 lg:px-8">
    <a href="/" class="text-xs text-neutral-500 hover:text-neutral-300">← На главную</a>

    <h1 class="mt-6 text-3xl font-medium text-neutral-50">{country.data.title}</h1>
    <p class="mt-3 text-sm leading-relaxed text-neutral-400">{country.data.description}</p>

    <div class="mt-6 flex flex-wrap gap-4 text-xs text-neutral-500">
      {country.data.currency && <span>Валюта: {country.data.currency}</span>}
      {country.data.bestTimeToVisit && <span>Лучшее время: {country.data.bestTimeToVisit}</span>}
    </div>

    <div class="prose prose-invert prose-sm mt-8 max-w-none prose-headings:font-medium prose-headings:text-neutral-100 prose-p:text-neutral-400">
      <Content />
    </div>

    {cities.length > 0 && (
      <section class="mt-12 border-t border-neutral-900 pt-10">
        <h2 class="mb-5 text-lg font-medium text-neutral-100">Города</h2>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          {cities.map((city) => (
            <a
              href={`/cities/${city.slug}`}
              class="rounded-2xl border border-neutral-800 bg-[#1B1B1F] p-4 transition-colors hover:border-neutral-600"
            >
              <h3 class="text-sm font-medium text-neutral-100">{city.data.title}</h3>
              <p class="mt-1 line-clamp-2 text-xs text-neutral-500">{city.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</BaseLayout>

