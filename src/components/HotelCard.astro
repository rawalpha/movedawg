---
import TierBadge from './TierBadge.astro';

interface Props {
  id: string;
  title: string;
  stars?: number;
  priceRange: 'budget' | 'mid' | 'luxury';
  rating: number;
  tier: 'free' | 'verified' | 'recommended';
  affiliateUrl: string;
}

const { id, title, stars, priceRange, rating, tier, affiliateUrl } = Astro.props;

const priceLabels: Record<string, string> = {
  budget: '$',
  mid: '$$',
  luxury: '$$$',
};
---

<article class={`group relative flex flex-col justify-between rounded-2xl border bg-[#0A0A0A] p-5 transition-colors duration-300 ${tier === 'recommended' ? 'border-accent/40 hover:border-accent' : 'border-neutral-800 hover:border-neutral-600'}`}>
  <div class="flex items-start justify-between gap-2">
    <div>
      <h3 class="text-sm font-medium text-neutral-100">{title}</h3>
      {stars && (
        <span class="text-[11px] text-neutral-500">{'★'.repeat(stars)}</span>
      )}
    </div>
    <TierBadge tier={tier} />
  </div>

  <div class="mt-5 flex items-center justify-between border-t border-neutral-800 pt-4">
    <div class="flex items-center gap-3 text-xs text-neutral-400">
      <span class="flex items-center gap-1">
        <svg class="h-3.5 w-3.5 text-neutral-200" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.79L10 14.9l-5.2 2.61.99-5.79-4.21-4.1 5.82-.85L10 1.5z" />
        </svg>
        <span class="text-neutral-200">{rating.toFixed(1)}</span>
      </span>
      <span class="text-neutral-500">{priceLabels[priceRange]}</span>
    </div>

    <div class="flex items-center gap-2">
      <a
        href={`/hotels/${id}`}
        class="rounded-full border border-neutral-800 px-3 py-1.5 text-xs text-neutral-400 transition-colors hover:border-neutral-600 hover:text-neutral-200"
      >
        Обзор
      </a>
      <a
        href={affiliateUrl}
        target="_blank"
        rel="nofollow sponsored noopener noreferrer"
        class="rounded-full bg-white px-3 py-1.5 text-xs font-medium text-black transition-opacity hover:opacity-85"
      >
        Забронировать
      </a>
    </div>
  </div>
</article>
