---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const tools = (await getCollection('tools')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryLabels: Record<string, string> = {
  esim: 'eSIM',
  insurance: 'Страховка',
  visa: 'Виза',
  app: 'Приложение',
  booking: 'Бронирование',
  transport: 'Транспорт',
  other: 'Другое',
};
---

<BaseLayout title="Полезные сервисы" description="eSIM, страховки, визовые сервисы и приложения для путешествий.">
  <main class="mx-auto max-w-4xl px-4 pb-24 pt-16 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-medium text-neutral-50">Полезные сервисы</h1>
    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {tools.map((tool) => (
        <a href={tool.data.affiliateUrl} target="_blank" rel="nofollow sponsored noopener noreferrer" class="rounded-2xl border border-neutral-800 bg-[#0A0A0A] p-4 transition-colors hover:border-neutral-600">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-medium text-neutral-100">{tool.data.title}</h2>
            <span class="rounded-full border border-neutral-800 px-2 py-0.5 text-[11px] text-neutral-500">
              {categoryLabels[tool.data.category]}
            </span>
          </div>
          <p class="mt-2 text-xs text-neutral-500">{tool.data.description}</p>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>

