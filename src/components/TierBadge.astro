---
interface Props {
  tier: 'free' | 'verified' | 'recommended';
}

const { tier } = Astro.props;

const config = {
  free: null, // для free ничего не показываем — бейдж это привилегия
  verified: {
    label: 'Проверено',
    class: 'border-neutral-700 text-neutral-300',
    icon: true,
  },
  recommended: {
    label: 'Рекомендовано',
    class: 'border-accent bg-accent/10 text-accent',
    icon: false,
  },
};

const badge = config[tier];
---

{badge && (
  <span class={`inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-[11px] font-medium ${badge.class}`}>
    {badge.icon && (
      <svg class="h-2.5 w-2.5" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd" />
      </svg>
    )}
    {badge.label}
  </span>
)}
