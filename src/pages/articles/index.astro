---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Статьи" description="Подборки, дайджесты и лайфхаки о путешествиях от Movedawg.">
  <main class="mx-auto max-w-6xl px-4 pb-24 pt-16 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-medium text-neutral-50">Статьи</h1>
    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {articles.map((article) => (
        <ArticleCard
          id={article.slug}
          title={article.data.title}
          summary={article.data.summary}
          tags={article.data.tags}
          coverImage={article.data.coverImage}
        />
      ))}
    </div>
  </main>
</BaseLayout>
